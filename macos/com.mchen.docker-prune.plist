<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mchen.docker-prune</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DOTFILES__/macos/docker-prune.sh</string>
  </array>
  <!-- Weekly: Sunday 03:00. Weekday 0 = Sunday. If asleep, runs at next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/docker-prune.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/docker-prune.log</string>
</dict>
</plist>
