// Zellij configuration
// https://zellij.dev/documentation/configuration

simplified_ui true
on_force_close "detach"
// theme "catppuccin-mocha"
// theme "kanagawa-dragon"
// theme "kanagawa-wave"
theme "rose-pine"
// theme "rose-pine-moon"
// theme "tokyonight-night"
pane_frames false
show_startup_tips false
show_release_notes false
styled_underlines true
copy_on_select true
default_layout "compact"

// Kanagawa Dragon (rebelot/kanagawa.nvim); not a Zellij built-in
themes {
    kanagawa-dragon {
        fg "#c5c9c5"
        bg "#282727"
        black "#0d0c0c"
        red "#c4746e"
        green "#87a987"
        yellow "#c4b28a"
        blue "#8ba4b0"
        magenta "#a292a3"
        cyan "#8ea4a2"
        white "#c8c093"
        orange "#b6927b"
    }
    // Kanagawa Wave (rebelot/kanagawa.nvim); not a Zellij built-in
    kanagawa-wave {
        fg "#dcd7ba"
        bg "#2a2a37"
        black "#16161d"
        red "#e46876"
        green "#98bb6c"
        yellow "#e6c384"
        blue "#7fb4ca"
        magenta "#957fb8"
        cyan "#7aa89f"
        white "#c8c093"
        orange "#ffa066"
    }
    // Rose Pine (rosepinetheme.com palette); not a Zellij built-in
    rose-pine {
        fg "#e0def4"
        bg "#403d52"
        black "#191724"
        red "#eb6f92"
        green "#31748f"
        yellow "#f6c177"
        blue "#9ccfd8"
        magenta "#c4a7e7"
        cyan "#ebbcba"
        white "#e0def4"
        orange "#ebbcba"
    }
    // Rose Pine Moon (rosepinetheme.com palette); not a Zellij built-in
    rose-pine-moon {
        fg "#e0def4"
        bg "#44415a"
        black "#232136"
        red "#eb6f92"
        green "#3e8fb0"
        yellow "#f6c177"
        blue "#9ccfd8"
        magenta "#c4a7e7"
        cyan "#ea9a97"
        white "#e0def4"
        orange "#ea9a97"
    }
    // TokyoNight Night (folke/tokyonight.nvim extras/zellij)
    tokyonight-night {
        fg "#c0caf5"
        bg "#292e42"
        black "#1a1b26"
        red "#f7768e"
        green "#9ece6a"
        yellow "#e0af68"
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#a9b1d6"
        orange "#ff9e64"
    }
}
